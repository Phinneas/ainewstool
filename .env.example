# S3 / Cloudflare R2
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=data-ingestion
S3_REGION=auto

# Firecrawl (fallback scraper — optional)
FIRECRAWL_API_KEY=

# Search APIs
EXA_API_KEY=                          # optional fallback
TAVILY_API_KEY=                        # https://tavily.com
PARALLEL_API_KEY=                      # https://platform.parallel.ai

# Parallel Monitor IDs (run `npx tsx setup-monitors.ts` once to generate)
PARALLEL_MONITOR_RESEARCH_ID=
PARALLEL_MONITOR_STARTUP_ID=

# LLM Providers
ANTHROPIC_API_KEY=
# Optional — pinned Claude model ID for stages 5-6. Defaults to claude-sonnet-5-5
# in src/llm/anthropic.ts. In the Worker this comes from [vars] in wrangler.toml
# instead; set it here only to override the local CLI runs.
ANTHROPIC_MODEL=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
# Required only when EVAL_PROVIDER is "jev" or "shadow" — Jev (TypeSafe System
# One) is reached through OpenRouter, not a first-party endpoint.
OPENROUTER_API_KEY=

# Stage 3 relevance provider: mistral | jev | shadow
# In the Worker these come from [vars] in wrangler.toml; set them here to
# override local CLI runs (npm run ingest).
EVAL_PROVIDER=mistral
RELEVANCE_THRESHOLD=0.35
STATE_CHAR_BUDGET=60000

# Reddit API (for fetching post details)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Email Delivery (Resend - https://resend.com)
RESEND_API_KEY=
NEWSLETTER_RECIPIENTS=

# Beehiiv (draft creation — v2 API requires pub_-prefixed publication ID)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Pexels (optional — header images for mymcpshelf D1 posts)
PEXELS_API_KEY=
